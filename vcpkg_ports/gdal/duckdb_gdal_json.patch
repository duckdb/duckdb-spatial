Rename the public json_object_get symbol of GDAL's vendored libjson to avoid
symbol clashes with other JSON libraries in the same process (e.g. json-c or
jansson, which export an incompatible json_object_get) when GDAL is statically
linked into the duckdb spatial extension. GDAL's own symbol_renames.h only
renames internal helper symbols, not this public one. The #define lives in the
vendored json_object.h, so both the definition (json_object.c) and every call
site inside GDAL (cpl_json.cpp, geojson driver, etc.) pick up the new name.

diff --git a/ogr/ogrsf_frmts/geojson/libjson/json_object.h b/ogr/ogrsf_frmts/geojson/libjson/json_object.h
index 05f25b0..085faca 100644
--- a/ogr/ogrsf_frmts/geojson/libjson/json_object.h
+++ b/ogr/ogrsf_frmts/geojson/libjson/json_object.h
@@ -17,6 +17,10 @@
 #ifndef _json_object_h_
 #define _json_object_h_

+/* DuckDB spatial: rename the public json_object_get symbol to avoid clashes
+ * with other JSON libraries when GDAL is statically linked. */
+#define json_object_get gdal__json_object_get
+
 #ifdef __GNUC__
 #define JSON_C_CONST_FUNCTION(func) func __attribute__((const))
 #else
