# name: test/sql/index/rtree_generated_columns.test
# group: [index]

# Regression test: the R-tree stores *physical* column ids while scans use *logical* column ids.
# These diverge when the table has generated columns. The deferred-bounds join scan used to compare
# them directly, matching the index on geom_b (physical id 1) against probes of geom_a (logical id 1),
# and then scanned the wrong index, silently dropping all join matches.
require spatial

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA threads=4;

statement ok
CREATE TABLE t (g AS (1), geom_a GEOMETRY, geom_b GEOMETRY);

statement ok
INSERT INTO t (geom_a, geom_b)
SELECT ST_Point(x, y), ST_Point(x + 500, y + 500)
FROM range(0, 100) r1(x), range(0, 100) r2(y);

statement ok
CREATE TABLE t_noidx AS SELECT geom_a, geom_b FROM t;

statement ok
CREATE INDEX t_idx ON t USING RTREE (geom_b);

statement ok
CREATE TABLE build_a (geom GEOMETRY);

statement ok
INSERT INTO build_a VALUES (ST_Point(50.5, 50.5));

statement ok
CREATE TABLE build_b (geom GEOMETRY);

statement ok
INSERT INTO build_b VALUES (ST_Point(550.5, 550.5));

# Probing geom_a must NOT use the index on geom_b (they share the id 1 in different id spaces)
query II
EXPLAIN SELECT count(*) FROM t p JOIN build_a b ON ST_DWithin(p.geom_a, b.geom, 3.0);
----
physical_plan	<!REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t p JOIN build_a b ON ST_DWithin(p.geom_a, b.geom, 3.0);
----
32

query I
SELECT (SELECT count(*) FROM t p JOIN build_a b ON ST_DWithin(p.geom_a, b.geom, 3.0))
     = (SELECT count(*) FROM t_noidx p JOIN build_a b ON ST_DWithin(p.geom_a, b.geom, 3.0));
----
true

# Probing geom_b (the actually indexed column) must still use the deferred index scan
query II
EXPLAIN SELECT count(*) FROM t p JOIN build_b b ON ST_DWithin(p.geom_b, b.geom, 3.0);
----
physical_plan	<REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t p JOIN build_b b ON ST_DWithin(p.geom_b, b.geom, 3.0);
----
32

query I
SELECT (SELECT count(*) FROM t p JOIN build_b b ON ST_DWithin(p.geom_b, b.geom, 3.0))
     = (SELECT count(*) FROM t_noidx p JOIN build_b b ON ST_DWithin(p.geom_b, b.geom, 3.0));
----
true

# The same applies to the plan-time index scans for constant predicates. Here the index on c (physical id 2) used
# to be matched against filters on a (logical id 1) and b (logical id 2), silently dropping all matching rows.
statement ok
CREATE TABLE t2 (g AS (1), a GEOMETRY, b GEOMETRY, c GEOMETRY);

statement ok
INSERT INTO t2 (a, b, c)
SELECT ST_Point(x, y), ST_Point(x + 500, y + 500), ST_Point(x + 1000, y + 1000)
FROM range(0, 100) r1(x), range(0, 100) r2(y);

statement ok
CREATE INDEX t2_idx ON t2 USING RTREE (c);

query II
EXPLAIN SELECT count(*) FROM t2 WHERE ST_Intersects(a, ST_MakeEnvelope(10, 10, 12, 12));
----
physical_plan	<!REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t2 WHERE ST_Intersects(a, ST_MakeEnvelope(10, 10, 12, 12));
----
9

query II
EXPLAIN SELECT count(*) FROM t2 WHERE ST_Intersects(c, ST_MakeEnvelope(1010, 1010, 1012, 1012));
----
physical_plan	<REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t2 WHERE ST_Intersects(c, ST_MakeEnvelope(1010, 1010, 1012, 1012));
----
9

# Without filter pushdown (the spatial predicate stays in a filter on top of the scan)
statement ok
SET disabled_optimizers = 'filter_pushdown';

query II
EXPLAIN SELECT count(*) FROM t2 WHERE ST_Intersects(b, ST_MakeEnvelope(510, 510, 512, 512));
----
physical_plan	<!REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t2 WHERE ST_Intersects(b, ST_MakeEnvelope(510, 510, 512, 512));
----
9

query II
EXPLAIN SELECT count(*) FROM t2 WHERE ST_Intersects(c, ST_MakeEnvelope(1010, 1010, 1012, 1012));
----
physical_plan	<REGEX>:.*RTREE_INDEX_SCAN.*

query I
SELECT count(*) FROM t2 WHERE ST_Intersects(c, ST_MakeEnvelope(1010, 1010, 1012, 1012));
----
9

statement ok
RESET disabled_optimizers;
