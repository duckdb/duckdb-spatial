# name: test/sql/window/st_clusterdbscan.test
# group: [window]

require spatial

#-----------------------------------------------------------------------------------------------------------------------
# Basic clustering
#-----------------------------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE points AS SELECT * FROM (VALUES
	(1, ST_Point(0, 0)),
	(2, ST_Point(1, 0)),
	(3, ST_Point(5, 5)),
	(4, ST_Point(5, 6)),
	(5, ST_Point(10, 10)),
	(6, NULL),
	(7, ST_GeomFromText('POINT EMPTY')),
	(8, ST_GeomFromText('LINESTRING EMPTY'))
) AS t(id, geom);

query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL
8	NULL

# Clusters are numbered in the order of their first core geometry
query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 2) OVER (ORDER BY id DESC) FROM points ORDER BY id;
----
1	1
2	1
3	0
4	0
5	NULL
6	NULL
7	NULL
8	NULL

# The distance is inclusive
query II
SELECT id, ST_ClusterDBSCAN(geom, 1, 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL
8	NULL

query II
SELECT id, ST_ClusterDBSCAN(geom, 0.99, 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
7	NULL
8	NULL

# Every geometry is a core geometry with minpoints <= 1
query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 1) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	2
6	NULL
7	NULL
8	NULL

query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 0) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	2
6	NULL
7	NULL
8	NULL

# minpoints includes the geometry itself
query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 3) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
7	NULL
8	NULL

# The window frame is ignored
query II
SELECT id, ST_ClusterDBSCAN(geom, 1.5, 2) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND CURRENT ROW) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL
8	NULL

# Duplicate points are within 0 distance of each other
query II
SELECT id, ST_ClusterDBSCAN(geom, 0, 2) OVER (ORDER BY id) FROM (VALUES
	(1, ST_Point(1, 1)),
	(2, ST_Point(2, 2)),
	(3, ST_Point(1, 1))
) AS t(id, geom) ORDER BY id;
----
1	0
2	NULL
3	0

# CRS-typed geometries
query II
SELECT id, ST_ClusterDBSCAN(geom::GEOMETRY('OGC:CRS84'), 1.5, 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL
8	NULL

# Prepared parameters
statement ok
PREPARE cluster_points AS SELECT id, ST_ClusterDBSCAN(geom, ?, ?) OVER (ORDER BY id) FROM points ORDER BY id;

query II
EXECUTE cluster_points(1.5, 2);
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL
8	NULL

# The distance check is exact, also for points that are not representable as floats (unlike their R-Tree boxes).
# Pairs of points that are 0.3 apart, which rounds to either side of 0.3 depending on the coordinates.
statement ok
CREATE TABLE pairs AS SELECT k, ST_Point((k // 2) * 10 + (k % 2) * 0.3 + 100000, 0) AS geom FROM range(20000) r(k);

query II
SELECT count(*) FILTER (WHERE within) > 0, count(*) FILTER (WHERE NOT within) > 0 FROM (
	SELECT ST_DWithin(a.geom, b.geom, 0.3) AS within FROM pairs a JOIN pairs b ON a.k + 1 = b.k AND a.k % 2 = 0
);
----
true	true

query I
SELECT count(*) FROM (
	SELECT k // 2 AS pair, bool_and(cluster IS NOT NULL) AS clustered, bool_or(cluster IS NOT NULL) AS any_clustered
	FROM (SELECT k, ST_ClusterDBSCAN(geom, 0.3, 2) OVER (ORDER BY k) AS cluster FROM pairs)
	GROUP BY pair
) c JOIN (
	SELECT a.k // 2 AS pair, ST_DWithin(a.geom, b.geom, 0.3) AS within
	FROM pairs a JOIN pairs b ON a.k + 1 = b.k AND a.k % 2 = 0
) d USING (pair)
WHERE clustered != within OR any_clustered != within;
----
0

#-----------------------------------------------------------------------------------------------------------------------
# Border geometries
#-----------------------------------------------------------------------------------------------------------------------
# Point 9 is a border point within eps of the core point 1 (cluster A) and the core point 5 (cluster B).
# It is assigned to the cluster of whichever of these comes first.

statement ok
CREATE TABLE border AS SELECT * FROM (VALUES
	(1, ST_Point(0, 0)),
	(2, ST_Point(-0.5, 0)),
	(3, ST_Point(-0.5, 0.3)),
	(4, ST_Point(-0.5, -0.3)),
	(5, ST_Point(2, 0)),
	(6, ST_Point(2.5, 0)),
	(7, ST_Point(2.5, 0.3)),
	(8, ST_Point(2.5, -0.3)),
	(9, ST_Point(1, 0))
) AS t(id, geom);

query II
SELECT id, ST_ClusterDBSCAN(geom, 1, 4) OVER (ORDER BY id) FROM border ORDER BY id;
----
1	0
2	0
3	0
4	0
5	1
6	1
7	1
8	1
9	0

query II
SELECT id, ST_ClusterDBSCAN(geom, 1, 4) OVER (ORDER BY id DESC) FROM border ORDER BY id;
----
1	1
2	1
3	1
4	1
5	0
6	0
7	0
8	0
9	0

#-----------------------------------------------------------------------------------------------------------------------
# Partitions
#-----------------------------------------------------------------------------------------------------------------------

query III
SELECT p, id, ST_ClusterDBSCAN(geom, 1.5, 2) OVER (PARTITION BY p ORDER BY id) FROM (VALUES
	(1, 1, ST_Point(0, 0)),
	(1, 2, ST_Point(0, 1)),
	(1, 3, ST_Point(10, 10)),
	(1, 4, ST_Point(10, 11)),
	(2, 5, ST_Point(0, 0)),
	(2, 6, ST_Point(100, 100)),
	(2, 7, ST_Point(100, 101)),
	(NULL, 8, ST_Point(0, 0)),
	(NULL, 9, ST_Point(0, 0))
) AS t(p, id, geom) ORDER BY id;
----
1	1	0
1	2	0
1	3	1
1	4	1
2	5	NULL
2	6	0
2	7	0
NULL	8	0
NULL	9	0

#-----------------------------------------------------------------------------------------------------------------------
# Non-point geometries
#-----------------------------------------------------------------------------------------------------------------------

query II
SELECT id, ST_ClusterDBSCAN(geom, 1, 2) OVER (ORDER BY id) FROM (VALUES
	(1, ST_GeomFromText('POLYGON((0 0, 2 0, 2 2, 0 2, 0 0))')),
	(2, ST_GeomFromText('POLYGON((3 0, 5 0, 5 2, 3 2, 3 0))')),
	(3, ST_GeomFromText('LINESTRING(10 0, 10 5)')),
	(4, ST_Point(11, 2)),
	(5, ST_Point(1, 1)),
	(6, ST_GeomFromText('POLYGON((20 20, 21 20, 21 21, 20 21, 20 20))'))
) AS t(id, geom) ORDER BY id;
----
1	0
2	0
3	1
4	1
5	0
6	NULL

# Multi-part geometries can connect geometries that are far apart
query II
SELECT id, ST_ClusterDBSCAN(geom, 1, 2) OVER (ORDER BY id) FROM (VALUES
	(1, ST_GeomFromText('MULTIPOINT((0 0), (10 10))')),
	(2, ST_Point(10, 10.5)),
	(3, ST_Point(0, 0.5)),
	(4, ST_Point(50, 50)),
	(5, ST_GeomFromText('GEOMETRYCOLLECTION(POINT(50 51), LINESTRING(70 70, 80 80))')),
	(6, ST_Point(80, 81))
) AS t(id, geom) ORDER BY id;
----
1	0
2	0
3	0
4	1
5	1
6	1

#-----------------------------------------------------------------------------------------------------------------------
# Errors
#-----------------------------------------------------------------------------------------------------------------------

statement error
SELECT ST_ClusterDBSCAN(geom, id, 2) OVER () FROM points;
----
must be a constant expression

statement error
SELECT ST_ClusterDBSCAN(geom, 1, id) OVER () FROM points;
----
must be a constant expression

statement error
SELECT ST_ClusterDBSCAN(geom, NULL, 2) OVER () FROM points;
----
must not be NULL

statement error
SELECT ST_ClusterDBSCAN(geom, -1, 2) OVER () FROM points;
----
eps must be a non-negative number

statement error
SELECT ST_ClusterDBSCAN(geom, 'nan'::DOUBLE, 2) OVER () FROM points;
----
eps must be a non-negative number

statement error
SELECT ST_ClusterDBSCAN(geom, 1, -1) OVER () FROM points;
----
minpoints must be a non-negative number

statement error
SELECT ST_ClusterDBSCAN(geom, 1, 2 ORDER BY id) OVER () FROM points;
----
ORDER BY is not supported

#-----------------------------------------------------------------------------------------------------------------------
# Large partitions (clustered by multiple threads)
#-----------------------------------------------------------------------------------------------------------------------
# 40 well separated blobs of 600 points each (on a jittered grid), followed by 100 isolated points

statement ok
SET threads = 4;

statement ok
CREATE TABLE blobs AS
SELECT
	b * 600 + i AS id,
	b AS blob,
	ST_Point(
		(b % 8) * 100 + (i % 25) * 0.4 + ((i * 37) % 97) / 970.0,
		(b // 8) * 100 + (i // 25) * 0.4 + ((i * 53) % 89) / 890.0
	) AS geom
FROM range(40) r1(b), range(600) r2(i)
UNION ALL
SELECT 100000 + i AS id, NULL AS blob, ST_Point(-1000 - i * 10, -1000) AS geom
FROM range(100) r(i);

# Each blob is one cluster
query II
SELECT count(*), count(DISTINCT cluster) FROM (
	SELECT blob, ST_ClusterDBSCAN(geom, 1, 5) OVER (ORDER BY id) AS cluster FROM blobs
) WHERE cluster IS DISTINCT FROM blob;
----
0	0

# A large partition of points, with a single other geometry (in the first blob) at the end
query II
SELECT count(DISTINCT cluster), any_value(cluster) FILTER (WHERE id = 200000) FROM (
	SELECT id, ST_ClusterDBSCAN(geom, 1, 5) OVER (ORDER BY id) AS cluster FROM (
		SELECT id, geom FROM blobs
		UNION ALL
		SELECT 200000, ST_MakeEnvelope(1, 1, 2, 2)
	)
);
----
40	0

# A mix of large and small partitions
query II
SELECT count(*), count(DISTINCT cluster) FROM (
	SELECT
		blob,
		CASE WHEN blob < 30 THEN 0 WHEN blob IS NOT NULL THEN 1 END AS p,
		ST_ClusterDBSCAN(geom, 1, 5) OVER (PARTITION BY p ORDER BY id) AS cluster
	FROM blobs
) WHERE cluster IS DISTINCT FROM CASE p WHEN 0 THEN blob WHEN 1 THEN blob - 30 END;
----
0	0

# Check the clustering against the DBSCAN definition, with parameters that produce border and noise geometries:
# - points: the blob points
# - polygons: small boxes at the blob points
# - shapes: groups of lines, groups of polygons with many vertices (so the indexes of their rings have multiple levels),
#   points inside some of these polygons, and isolated geometries.

statement ok
CREATE TABLE inputs AS
SELECT 'points' AS kind, id, blob, geom FROM blobs
UNION ALL
SELECT 'polygons' AS kind, id, blob, ST_MakeEnvelope(ST_X(geom), ST_Y(geom), ST_X(geom) + 0.05, ST_Y(geom) + 0.05) AS geom
FROM blobs;

statement ok
CREATE MACRO zigzag(x, y) AS ST_MakeLine([ST_Point(x + j * 0.2, y + (j % 2) * 0.3) FOR j IN range(101)]);

statement ok
CREATE MACRO circle(x, y) AS
ST_MakePolygon(ST_MakeLine([ST_Point(x + cos(2 * pi() * (j % 64) / 64), y + sin(2 * pi() * (j % 64) / 64)) FOR j IN range(65)]));

statement ok
INSERT INTO inputs
-- Groups of 10 zigzag lines, each within 0.5 of the previous and the next one
SELECT 'shapes', 300000 + k, k // 10, zigzag(0, k * 0.4 + (k // 10) * 5) FROM range(100) r(k)
UNION ALL
-- Groups of 10 circles, each within 0.5 of the previous and the next one
SELECT 'shapes', 400000 + c, 100 + c // 10, circle((c % 10) * 2.3, 500 + (c // 10) * 10) FROM range(100) r(c)
UNION ALL
-- Points at the center of every third circle
SELECT 'shapes', 500000 + c, 100 + c // 10, ST_Point((c % 10) * 2.3, 500 + (c // 10) * 10) FROM range(0, 100, 3) r(c)
UNION ALL
-- A pair of lines that are neighbours, but not core geometries
SELECT 'shapes', 600000 + i, 200, zigzag(-300, -300 + i * 0.4) FROM range(2) r(i)
UNION ALL
-- Isolated lines and circles
SELECT 'shapes', 610000 + i, NULL, zigzag(-500, -500 - i * 10) FROM range(5) r(i)
UNION ALL
SELECT 'shapes', 620000 + i, NULL, circle(-800 - i * 10, -800) FROM range(5) r(i);

statement ok
CREATE TABLE params AS SELECT * FROM (VALUES ('points', 1, 20), ('polygons', 1, 20), ('shapes', 0.5, 3)) AS t(kind, eps, minpoints);

# One spatial join per kind (joining on the kind as well would turn this into a hash join)
statement ok
CREATE TABLE neighbours AS
SELECT 'points' AS kind, a.id AS lhs, b.id AS rhs
FROM (FROM inputs WHERE kind = 'points') a JOIN (FROM inputs WHERE kind = 'points') b ON ST_DWithin(a.geom, b.geom, 1)
UNION ALL
SELECT 'polygons' AS kind, a.id AS lhs, b.id AS rhs
FROM (FROM inputs WHERE kind = 'polygons') a JOIN (FROM inputs WHERE kind = 'polygons') b ON ST_DWithin(a.geom, b.geom, 1)
UNION ALL
SELECT 'shapes' AS kind, a.id AS lhs, b.id AS rhs
FROM (FROM inputs WHERE kind = 'shapes') a JOIN (FROM inputs WHERE kind = 'shapes') b ON ST_DWithin(a.geom, b.geom, 0.5);

statement ok
CREATE TABLE core AS
SELECT kind, lhs AS id, count(*) >= any_value(minpoints) AS is_core FROM neighbours JOIN params USING (kind) GROUP BY kind, lhs;

statement ok
CREATE MACRO clusters_of(k, e, m) AS TABLE
SELECT kind, id, blob, ST_ClusterDBSCAN(geom, e, m) OVER (ORDER BY id) AS cluster FROM inputs WHERE kind = k;

statement ok
CREATE TABLE clusters AS
FROM clusters_of('points', 1, 20) UNION ALL FROM clusters_of('polygons', 1, 20) UNION ALL FROM clusters_of('shapes', 0.5, 3);

# Make sure that there are border geometries, and noise geometries that do have neighbours
query II
SELECT kind, count(*) > 0 FROM clusters JOIN core USING (kind, id) WHERE NOT is_core AND cluster IS NOT NULL GROUP BY kind ORDER BY kind;
----
points	true
polygons	true
shapes	true

query II
SELECT kind, count(*) > 0 FROM clusters WHERE cluster IS NULL AND blob IS NOT NULL GROUP BY kind ORDER BY kind;
----
points	true
polygons	true
shapes	true

query II
SELECT count(DISTINCT cluster), count(*) FILTER (WHERE cluster IS NULL) FROM clusters WHERE kind = 'shapes';
----
20	12

# Core geometries are clustered
query I
SELECT count(*) FROM clusters JOIN core USING (kind, id) WHERE is_core AND cluster IS NULL;
----
0

# Neighbouring core geometries are in the same cluster
query I
SELECT count(*)
FROM neighbours n
JOIN core c1 ON c1.kind = n.kind AND c1.id = n.lhs
JOIN core c2 ON c2.kind = n.kind AND c2.id = n.rhs
JOIN clusters r1 ON r1.kind = n.kind AND r1.id = n.lhs
JOIN clusters r2 ON r2.kind = n.kind AND r2.id = n.rhs
WHERE c1.is_core AND c2.is_core AND r1.cluster IS DISTINCT FROM r2.cluster;
----
0

# Other geometries are in the cluster of their first core neighbour, or noise if they have none
query I
SELECT count(*)
FROM clusters r
JOIN core c USING (kind, id)
LEFT JOIN (
	SELECT n.kind, n.lhs AS id, min(n.rhs) AS first_core
	FROM neighbours n JOIN core c ON c.kind = n.kind AND c.id = n.rhs
	WHERE c.is_core
	GROUP BY n.kind, n.lhs
) f USING (kind, id)
LEFT JOIN clusters fr ON fr.kind = f.kind AND fr.id = f.first_core
WHERE NOT c.is_core AND r.cluster IS DISTINCT FROM fr.cluster;
----
0

# Clusters never span blobs
query I
SELECT count(*) FROM (
	SELECT kind, cluster FROM clusters WHERE cluster IS NOT NULL GROUP BY kind, cluster HAVING count(DISTINCT blob) > 1
);
----
0

# Clusters are numbered from 0, in the order of their first core geometry
query I
SELECT count(*) FROM (
	SELECT kind, cluster, row_number() OVER (PARTITION BY kind ORDER BY min(id) FILTER (WHERE is_core)) - 1 AS expected
	FROM clusters JOIN core USING (kind, id)
	WHERE cluster IS NOT NULL
	GROUP BY kind, cluster
) WHERE cluster != expected;
----
0

# The result does not depend on the number of threads, or on clustering multiple large partitions in one query
statement ok
SET threads = 1;

query I
SELECT count(*) FROM clusters r JOIN (
	SELECT kind, id, ST_ClusterDBSCAN(geom, 1, 20) OVER (PARTITION BY kind ORDER BY id) AS cluster
	FROM inputs WHERE kind IN ('points', 'polygons')
	UNION ALL
	SELECT kind, id, cluster FROM clusters_of('shapes', 0.5, 3)
) s USING (kind, id)
WHERE r.cluster IS DISTINCT FROM s.cluster;
----
0
