# name: test/sql/window/st_clusterkmeans.test
# group: [window]

require spatial

#-----------------------------------------------------------------------------------------------------------------------
# Basic clustering
#-----------------------------------------------------------------------------------------------------------------------

statement ok
CREATE TABLE points AS SELECT * FROM (VALUES
	(1, ST_Point(0, 0)),
	(2, ST_Point(1, 0)),
	(3, ST_Point(10, 10)),
	(4, ST_Point(11, 10)),
	(5, NULL),
	(6, ST_GeomFromText('POINT EMPTY')),
	(7, ST_GeomFromText('POLYGON EMPTY'))
) AS t(id, geom);

query II
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL

# Clusters are numbered in the order of their first geometry
query II
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id DESC) FROM points ORDER BY id;
----
1	1
2	1
3	0
4	0
5	NULL
6	NULL
7	NULL

query II
SELECT id, ST_ClusterKMeans(geom, 1) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	0
4	0
5	NULL
6	NULL
7	NULL

# There can not be more clusters than geometries
query II
SELECT id, ST_ClusterKMeans(geom, 10) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	1
3	2
4	3
5	NULL
6	NULL
7	NULL

# Or than distinct geometries
query II
SELECT id, ST_ClusterKMeans(geom, 3) OVER (ORDER BY id) FROM (VALUES
	(1, ST_Point(1, 1)),
	(2, ST_Point(1, 1)),
	(3, ST_Point(1, 1)),
	(4, ST_Point(2, 2))
) AS t(id, geom) ORDER BY id;
----
1	0
2	0
3	0
4	1

# The window frame is ignored
query II
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND CURRENT ROW) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL

# CRS-typed geometries
query II
SELECT id, ST_ClusterKMeans(geom::GEOMETRY('OGC:CRS84'), 2) OVER (ORDER BY id) FROM points ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL

# Prepared parameters
statement ok
PREPARE cluster_points AS SELECT id, ST_ClusterKMeans(geom, ?) OVER (ORDER BY id) FROM points ORDER BY id;

query II
EXECUTE cluster_points(2);
----
1	0
2	0
3	1
4	1
5	NULL
6	NULL
7	NULL

#-----------------------------------------------------------------------------------------------------------------------
# Partitions
#-----------------------------------------------------------------------------------------------------------------------

query III
SELECT p, id, ST_ClusterKMeans(geom, 2) OVER (PARTITION BY p ORDER BY id) FROM (VALUES
	(1, 1, ST_Point(0, 0)),
	(1, 2, ST_Point(0, 1)),
	(1, 3, ST_Point(10, 10)),
	(2, 4, ST_Point(100, 100)),
	(2, 5, ST_Point(0, 0)),
	(2, 6, ST_Point(100, 101)),
	(3, 7, ST_Point(5, 5))
) AS t(p, id, geom) ORDER BY id;
----
1	1	0
1	2	0
1	3	1
2	4	0
2	5	1
2	6	0
3	7	0

#-----------------------------------------------------------------------------------------------------------------------
# Non-point geometries and weights
#-----------------------------------------------------------------------------------------------------------------------

# Geometries are clustered by their centroid
query II
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id) FROM (VALUES
	(1, ST_GeomFromText('POLYGON((0 0, 2 0, 2 2, 0 2, 0 0))')),
	(2, ST_GeomFromText('LINESTRING(20 20, 22 22)')),
	(3, ST_Point(1, 1)),
	(4, ST_GeomFromText('MULTIPOINT((20 22), (22 20))'))
) AS t(id, geom) ORDER BY id;
----
1	0
2	1
3	0
4	1

# The M value of a point is its weight
query II
SELECT id, ST_ClusterKMeans(geom, 2) OVER (ORDER BY id) FROM (VALUES
	(1, ST_GeomFromText('POINT M (0 0 1)')),
	(2, ST_GeomFromText('POINT M (1 0 5)')),
	(3, ST_GeomFromText('POINT ZM (100 0 5 2)')),
	(4, ST_GeomFromText('POINT M (101 0 0.5)'))
) AS t(id, geom) ORDER BY id;
----
1	0
2	0
3	1
4	1

statement error
SELECT ST_ClusterKMeans(ST_GeomFromText('POINT M (0 0 0)'), 2) OVER ();
----
must be larger than 0

statement error
SELECT ST_ClusterKMeans(ST_GeomFromText('POINT ZM (0 0 0 -1)'), 2) OVER ();
----
must be larger than 0

#-----------------------------------------------------------------------------------------------------------------------
# Errors
#-----------------------------------------------------------------------------------------------------------------------

statement error
SELECT ST_ClusterKMeans(geom, id) OVER () FROM points;
----
must be a constant expression

statement error
SELECT ST_ClusterKMeans(geom, NULL) OVER () FROM points;
----
must not be NULL

statement error
SELECT ST_ClusterKMeans(geom, 0) OVER () FROM points;
----
k must be larger than 0

statement error
SELECT ST_ClusterKMeans(geom, 2 ORDER BY id) OVER () FROM points;
----
ORDER BY is not supported

#-----------------------------------------------------------------------------------------------------------------------
# Large partitions (clustered by multiple threads)
#-----------------------------------------------------------------------------------------------------------------------
# 40 well separated blobs of 600 points each (on a jittered grid), and some polygons

statement ok
SET threads = 4;

statement ok
CREATE TABLE blobs AS
SELECT
	b * 600 + i AS id,
	ST_Point(
		(b % 8) * 100 + (i % 25) * 0.4 + ((i * 37) % 97) / 970.0,
		(b // 8) * 100 + (i // 25) * 0.4 + ((i * 53) % 89) / 890.0
	) AS geom
FROM range(40) r1(b), range(600) r2(i)
UNION ALL
SELECT 100000 + i AS id, ST_MakeEnvelope(i * 30, -50, i * 30 + 2, -48) AS geom
FROM range(20) r(i);

statement ok
CREATE TABLE clusters AS
SELECT id, geom, ST_ClusterKMeans(geom, 40) OVER (ORDER BY id) AS cluster FROM blobs;

# Clusters are numbered from 0, in the order of their first geometry
query I
SELECT count(*) FROM (
	SELECT cluster, row_number() OVER (ORDER BY min(id)) - 1 AS expected FROM clusters GROUP BY cluster
) WHERE cluster != expected;
----
0

query I
SELECT count(*) FROM clusters WHERE cluster IS NULL OR cluster < 0 OR cluster >= 40;
----
0

# Every geometry is (within rounding) in the cluster with the nearest center
query I
WITH centroids AS (
	SELECT id, cluster, ST_X(ST_Centroid(geom)) AS x, ST_Y(ST_Centroid(geom)) AS y FROM clusters
), centers AS (
	SELECT cluster, avg(x) AS x, avg(y) AS y FROM centroids GROUP BY cluster
), distances AS (
	SELECT p.id, p.cluster = c.cluster AS own, (p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y) AS distance
	FROM centroids p, centers c
)
SELECT count(*) FROM (
	SELECT id, min(distance) FILTER (WHERE own) AS own_distance, min(distance) AS nearest_distance
	FROM distances GROUP BY id
) WHERE own_distance > nearest_distance + 1e-6;
----
0

# The result does not depend on the number of threads
statement ok
SET threads = 1;

query I
SELECT count(*) FROM clusters r JOIN (
	SELECT id, ST_ClusterKMeans(geom, 40) OVER (ORDER BY id) AS cluster FROM blobs
) s USING (id)
WHERE r.cluster IS DISTINCT FROM s.cluster;
----
0

# With weights, and clusters that touch each other (two per blob, on average), so the weights do matter.
# Every point is (within rounding) in the cluster with the nearest weighted center.
statement ok
SET threads = 4;

statement ok
CREATE TABLE weighted AS
SELECT id, ST_X(geom) AS x, ST_Y(geom) AS y, 1 + (id * 7) % 10 AS w FROM blobs WHERE id < 100000;

query I
WITH clusters AS (
	SELECT id, x, y, w, ST_ClusterKMeans(ST_MakePoint(x, y, 0, w), 80) OVER (ORDER BY id) AS cluster FROM weighted
), centers AS (
	SELECT cluster, sum(w * x) / sum(w) AS x, sum(w * y) / sum(w) AS y FROM clusters GROUP BY cluster
), distances AS (
	SELECT p.id, p.cluster = c.cluster AS own, (p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y) AS distance
	FROM clusters p, centers c
)
SELECT count(*) FROM (
	SELECT id, min(distance) FILTER (WHERE own) AS own_distance, min(distance) AS nearest_distance
	FROM distances GROUP BY id
) WHERE own_distance > nearest_distance + 1e-6;
----
0
