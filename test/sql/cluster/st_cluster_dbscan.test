# name: test/sql/cluster/st_cluster_dbscan.test
# description: Test ST_ClusterDBSCAN window aggregate function
# group: [cluster]

require spatial

# Test basic clustering of 2 clusters and 1 noise point
statement ok
CREATE TABLE points AS SELECT {'x': x::DOUBLE, 'y': y::DOUBLE}::POINT_2D AS pt, id FROM (
    VALUES
        (0.0, 0.0, 1),
        (0.1, 0.0, 2),
        (0.0, 0.1, 3),
        (0.1, 0.1, 4),
        (5.0, 5.0, 5),
        (5.1, 5.0, 6),
        (5.0, 5.1, 7),
        (5.1, 5.1, 8),
        (2.5, 2.5, 9)
) t(x, y, id);

query II
SELECT id, ST_ClusterDBSCAN(pt, 0.2, 3) OVER () AS cid FROM points ORDER BY id;
----
1	0
2	0
3	0
4	0
5	1
6	1
7	1
8	1
9	NULL

# Test NULL handling
statement ok
INSERT INTO points VALUES (NULL, 10);

query II
SELECT id, ST_ClusterDBSCAN(pt, 0.2, 3) OVER () AS cid FROM points WHERE id = 10;
----
10	NULL

# Test PostGIS Documentation Example (eps=50, minpoints=2)
statement ok
CREATE TABLE postgis_doc AS SELECT {'x': x::DOUBLE, 'y': y::DOUBLE}::POINT_2D AS pt, id FROM (
    VALUES
        (5.0, 5.0, 1),
        (35.0, 5.0, 2),
        (105.0, 5.0, 3),
        (135.0, 5.0, 4),
        (255.0, 5.0, 5)
) t(x, y, id);

query II
SELECT id, ST_ClusterDBSCAN(pt, 50.0, 2) OVER () AS cid FROM postgis_doc ORDER BY id;
----
1	0
2	0
3	1
4	1
5	NULL

# Test PostGIS Regression t101 (eps=0.8, minpoints=1)
statement ok
CREATE TABLE postgis_t101 AS SELECT {'x': x::DOUBLE, 'y': y::DOUBLE}::POINT_2D AS pt, id FROM (
    VALUES
        (0.0, 0.0, 1),
        (0.0, 1.0, 2),
        (-0.5, 0.5, 3),
        (1.0, 0.0, 4),
        (1.0, 1.0, 5),
        (1.0, 0.5, 6)
) t(x, y, id);

query II
SELECT id, ST_ClusterDBSCAN(pt, 0.8, 1) OVER () AS cid FROM postgis_t101 ORDER BY id;
----
1	0
2	0
3	0
4	1
5	1
6	1

# Test PostGIS Regression t102 (eps=0.8, minpoints=4 -> all noise)
query II
SELECT id, ST_ClusterDBSCAN(pt, 0.8, 4) OVER () AS cid FROM postgis_t101 ORDER BY id;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL

# Test PostGIS Regression t103 (eps=0.6, minpoints=3 -> left noise, right cluster 0)
query II
SELECT id, ST_ClusterDBSCAN(pt, 0.6, 3) OVER () AS cid FROM postgis_t101 ORDER BY id;
----
1	NULL
2	NULL
3	NULL
4	0
5	0
6	0

# Test PostGIS Regression #3612b (single point with minpoints=5 -> noise)
statement ok
CREATE TABLE single_pt AS SELECT {'x': 1.0::DOUBLE, 'y': 1.0::DOUBLE}::POINT_2D AS pt, 1 AS id;

query II
SELECT id, ST_ClusterDBSCAN(pt, 20.1, 5) OVER () AS cid FROM single_pt;
----
1	NULL

