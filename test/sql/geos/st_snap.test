# name: test/sql/geos/st_snap.test
# group: [geos]

require spatial

# Multipolygon snapped to linestring at 1.01x distance
query I
SELECT ST_AsText(ST_Snap(poly, line, ST_Distance(poly, line) * 1.01))
FROM (SELECT
    ST_GeomFromText('MULTIPOLYGON(((26 125,26 200,126 200,126 125,26 125),(51 150,101 150,76 175,51 150)),((151 100,151 200,176 175,151 100)))') AS poly,
    ST_GeomFromText('LINESTRING(5 107,54 84,101 100)') AS line
) AS foo;
----
MULTIPOLYGON (((26 125, 26 200, 126 200, 126 125, 101 100, 26 125), (51 150, 101 150, 76 175, 51 150)), ((151 100, 151 200, 176 175, 151 100)))

# Multipolygon snapped to linestring at 1.25x distance (more vertices snap)
query I
SELECT ST_AsText(ST_Snap(poly, line, ST_Distance(poly, line) * 1.25))
FROM (SELECT
    ST_GeomFromText('MULTIPOLYGON(((26 125,26 200,126 200,126 125,26 125),(51 150,101 150,76 175,51 150)),((151 100,151 200,176 175,151 100)))') AS poly,
    ST_GeomFromText('LINESTRING(5 107,54 84,101 100)') AS line
) AS foo;
----
MULTIPOLYGON (((5 107, 26 200, 126 200, 126 125, 101 100, 54 84, 5 107), (51 150, 101 150, 76 175, 51 150)), ((151 100, 151 200, 176 175, 151 100)))

# Linestring snapped to multipolygon at 1.01x distance
query I
SELECT ST_AsText(ST_Snap(line, poly, ST_Distance(poly, line) * 1.01))
FROM (SELECT
    ST_GeomFromText('MULTIPOLYGON(((26 125,26 200,126 200,126 125,26 125),(51 150,101 150,76 175,51 150)),((151 100,151 200,176 175,151 100)))') AS poly,
    ST_GeomFromText('LINESTRING(5 107,54 84,101 100)') AS line
) AS foo;
----
LINESTRING (5 107, 26 125, 54 84, 101 100)

# Linestring snapped to multipolygon at 1.25x distance (endpoint absorbed)
query I
SELECT ST_AsText(ST_Snap(line, poly, ST_Distance(poly, line) * 1.25))
FROM (SELECT
    ST_GeomFromText('MULTIPOLYGON(((26 125,26 200,126 200,126 125,26 125),(51 150,101 150,76 175,51 150)),((151 100,151 200,176 175,151 100)))') AS poly,
    ST_GeomFromText('LINESTRING(5 107,54 84,101 100)') AS line
) AS foo;
----
LINESTRING (26 125, 54 84, 101 100)

# Empty geometry (GEOS-internal Z promotion on empty results)
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING EMPTY'),
    ST_GeomFromText('LINESTRING(0 0,1 1)'),
    0.5
));
----
LINESTRING Z EMPTY

# Snap with a tolerance of 0 should return the input geometry unaltered
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0, 5 5)'), 
    ST_GeomFromText('POINT(0.1 0.1)'), 
    0.0
));
----
LINESTRING (0 0, 5 5)

# Snap with a negative tolerance should return the input geometry unaltered
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0, 5 5)'), 
    ST_GeomFromText('POINT(0.1 0.1)'), 
    -1.5
));
----
LINESTRING (0 0, 5 5)

# Snapping an empty geometry as the reference target should return input unaltered
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0, 10 10)'), 
    ST_GeomFromText('POINT EMPTY'), 
    5.0
));
----
LINESTRING (0 0, 10 10)

# Snapping a geometry to itself should return the geometry unaltered
query I
SELECT ST_AsText(ST_Snap(geom, geom, 10.0))
FROM (SELECT ST_GeomFromText('LINESTRING(0 0, 2 2, 5 5)') AS geom);
----
LINESTRING (0 0, 2 2, 5 5)

# NULL handling: Any NULL input arguments should result in a NULL output
query I
SELECT ST_Snap(NULL, ST_GeomFromText('POINT(0 0)'), 1.0);
----
NULL

query I
SELECT ST_Snap(ST_GeomFromText('POINT(0 0)'), NULL, 1.0);
----
NULL

query I
SELECT ST_Snap(ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('POINT(0 0)'), NULL);
----
NULL

# Implicit Casting: Ensure an INTEGER tolerance parameter is implicitly cast to DOUBLE
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('LINESTRING(0 0, 10 0)'), 
    ST_GeomFromText('POINT(5 1)'), 
    2
));
----
LINESTRING (0 0, 5 1, 10 0)

# GeometryCollection handling
query I
SELECT ST_AsText(ST_Snap(
    ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(0 0, 10 0))'), 
    ST_GeomFromText('POINT(5 1)'), 
    2.0
));
----
GEOMETRYCOLLECTION (POINT (0 0), LINESTRING (0 0, 5 1, 10 0))

# Ensure ST_Snap handles multi-row vectors correctly
statement ok
CREATE TABLE test_snap_vector AS 
SELECT 
    ST_GeomFromText('LINESTRING(0 0, 10 0)') AS g1, 
    ST_GeomFromText('POINT(5 1)') AS g2, 
    2.0 AS tol
UNION ALL
SELECT 
    ST_GeomFromText('LINESTRING(0 0, 5 0)') AS g1, 
    ST_GeomFromText('POINT(2.5 0.5)') AS g2, 
    1.0 AS tol;

query I
SELECT ST_AsText(ST_Snap(g1, g2, tol)) FROM test_snap_vector;
----
LINESTRING (0 0, 5 1, 10 0)
LINESTRING (0 0, 2.5 0.5, 5 0)