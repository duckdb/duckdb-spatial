# name: test/sql/geometry_always_xy.test
# description: Axis-order sensitive functions require 'geometry_always_xy' to be set explicitly since v2.0

require spatial

statement error
SELECT ST_Distance_Sphere(ST_Point(0, 0), ST_Point(1, 1));
----
Invalid Configuration Error: The 'ST_Distance_Sphere' function is sensitive to the coordinate axis order of the input geometry.
Unless 'geometry_always_xy' is enabled, all input geometries are assumed to be in [LATITUDE, LONGITUDE] axis order.
In DuckDB v2.0, the 'geometry_always_xy' setting must be set explicitly to use this functionality.
In DuckDB v2.1, 'geometry_always_xy = true' will become the default.
To make this error go away:
 * 'SET geometry_always_xy = true' to always assume [EASTING, NORTHING] (= LONGITUDE, LATITUDE) axis order (recommended)
 * 'SET geometry_always_xy = false' to keep the pre-v2.0 behavior

statement error
SELECT ST_Distance_Spheroid(ST_Point(0, 0), ST_Point(1, 1));
----
Invalid Configuration Error: The 'ST_Distance_Spheroid' function is sensitive to the coordinate axis order

statement error
SELECT ST_DWithin_Spheroid(ST_Point(0, 0), ST_Point(1, 1), 1.0);
----
Invalid Configuration Error: The 'ST_DWithin_Spheroid' function is sensitive to the coordinate axis order

statement error
SELECT ST_Area_Spheroid('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'::GEOMETRY);
----
Invalid Configuration Error: The 'ST_Area_Spheroid' function is sensitive to the coordinate axis order

statement error
SELECT ST_Perimeter_Spheroid('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'::GEOMETRY);
----
Invalid Configuration Error: The 'ST_Perimeter_Spheroid' function is sensitive to the coordinate axis order

statement error
SELECT ST_Transform(ST_Point(0, 0), 'EPSG:4326', 'EPSG:3857');
----
Invalid Configuration Error: 'ST_Transform' is sensitive to the coordinate axis order

# The explicit per-call parameter does not require the setting
statement ok
SELECT ST_Transform(ST_Point(0, 0), 'EPSG:4326', 'EPSG:3857', true);

statement error
COPY (SELECT ST_Point(0, 0) as geom) TO '{TEST_DIR}/always_xy.kml' WITH (FORMAT GDAL, DRIVER 'KML', SRS 'EPSG:4326');
----
Invalid Configuration Error: GDAL COPY TO with an SRS is sensitive to the coordinate axis order

# Writing without an SRS does not depend on the axis order
statement ok
COPY (SELECT ST_Point(0, 0) as geom) TO '{TEST_DIR}/always_xy.geojson' WITH (FORMAT GDAL, DRIVER 'GeoJSON');

# Once set, everything works
statement ok
SET geometry_always_xy = true;

statement ok
SELECT ST_Distance_Sphere(ST_Point(0, 0), ST_Point(1, 1));

statement ok
SELECT ST_Transform(ST_Point(0, 0), 'EPSG:4326', 'EPSG:3857');

statement ok
COPY (SELECT ST_Point(0, 0) as geom) TO '{TEST_DIR}/always_xy.kml' WITH (FORMAT GDAL, DRIVER 'KML', SRS 'EPSG:4326');

# RESET stores the setting's default, NULL, as the session value, which counts as not set
statement ok
RESET geometry_always_xy;

statement error
SELECT ST_Distance_Sphere(ST_Point(0, 0), ST_Point(1, 1));
----
Invalid Configuration Error: The 'ST_Distance_Sphere' function is sensitive to the coordinate axis order
